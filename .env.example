NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Required on Vercel: Project Settings → Environment Variables → add for Production (and Preview).
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local only. On Vercel leave AUTH_URL unset (or set it to https://your-app.vercel.app).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
ADMIN_EMAILS="admin@leafyland.com"

# Optional Google Sign-In. If set, users sign in with Google as a separate account
# unless they already use the same Auth.js linked account (email linking is disabled).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH=""
